{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rupix/plugin-manifest-v1.json",
  "title": "RuPix plugin manifest (schema 1)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "protocol",
    "min_host",
    "kind",
    "entry",
    "platforms"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
    "protocol": { "type": "integer", "minimum": 1, "maximum": 1 },
    "min_host": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
    "kind": { "enum": ["command", "editor", "panel"] },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\\\.\\.\\\\).*$"
    },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "image.read",
          "image.write",
          "selection.read",
          "clipboard.write",
          "file.read",
          "file.write",
          "network",
          "ui.window",
          "ui.panel",
          "settings.read",
          "settings.write",
          "process.spawn"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "contains": { "const": "windows-x64" }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800000
    },
    "hotkey": { "type": "string" },
    "settings_ui": {
      "type": "boolean",
      "default": false,
      "description": "插件自带设置窗口：宿主在插件卡上给一颗齿轮，以 action=settings 拉起；必须同时声明 settings.write"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "released": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
