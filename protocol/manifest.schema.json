{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rupix/plugin-manifest-v1.json",
  "title": "RuPix plugin manifest (schema 1)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "protocol",
    "min_host",
    "kind",
    "entry",
    "platforms"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
    "protocol": { "type": "integer", "minimum": 1, "maximum": 1 },
    "min_host": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
    "kind": { "enum": ["command", "editor", "panel"] },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\\\.\\.\\\\).*$"
    },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "image.read",
          "image.write",
          "selection.read",
          "clipboard.write",
          "file.read",
          "file.write",
          "network",
          "ui.window",
          "ui.panel",
          "settings.read",
          "settings.write",
          "process.spawn",
          "open.url",
          "open.file"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "contains": { "const": "windows-x64" }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800000
    },
    "hotkey": { "type": "string" },
    "settings_ui": {
      "type": "boolean",
      "default": false,
      "description": "插件自带设置窗口：宿主在插件卡上给一颗齿轮，以 action=settings 拉起；必须同时声明 settings.write"
    },
    "settings": {
      "type": "array",
      "description": "声明式设置项（协议 v1 加法式新增）：给了它，宿主**自己渲染**设置窗（齿轮 → 宿主窗口），不再以 action=settings 拉起插件；与 settings_ui 二选一。必须同时声明 settings.read 与 settings.write。type=hotkey 的那一项就是该插件的动态热键。",
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "description": "设置区里的键名（plugins/<id>/settings.json 的键）"
          },
          "label": { "type": "string", "minLength": 1 },
          "type": { "enum": ["bool", "choice", "int", "text", "hotkey"] },
          "default": {
            "description": "缺省值。缺省：bool=false、int=0、choice=choices[0]、text/hotkey=空串"
          },
          "choices": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "仅 type=choice：可选值（存的就是这里的字符串）"
          },
          "labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "仅 type=choice：给人看的标签，与 choices 等长；空 = 直接显示取值"
          }
        }
      }
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "released": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
